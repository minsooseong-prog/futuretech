# ---------------------------------------------------------------
# Neon PostgreSQL — primary application database (server only)
# Use the POOLED connection string ("-pooler" host) from Neon.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------
# Supabase — file storage only (no Supabase Postgres is used)
# ---------------------------------------------------------------
# Server-side admin access. NEVER expose these to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=future-tech

# Safe to expose. Only used if you later add client-side Supabase features.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------
# Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string

# Seed values (optional). Used by `npm run db:seed` only.
ADMIN_STUDENT_ID=00000
ADMIN_NAME=N
ADMIN_PASSWORD=NNNNN
DEFAULT_NOTICE_PASSWORD=00000
DEFAULT_CALENDAR_PASSWORD=00000
